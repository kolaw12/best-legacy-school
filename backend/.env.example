# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-generate-new-one
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Database (Render will provide this automatically)
DATABASE_URL=postgresql://user:password@host:port/database

# Email Configuration (leave unset to use the console backend in dev)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here

# Frontend URL (for CORS) — added automatically to CORS_ALLOWED_ORIGINS
FRONTEND_URL=https://your-frontend.vercel.app

# CORS: comma-separated extra origins (custom domains, preview URLs).
# Leave both unset in production to allow only FRONTEND_URL.
# Set CORS_ALLOW_ALL_ORIGINS=True temporarily if you need the old permissive behavior.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=False

# Error monitoring (optional). Leave SENTRY_DSN unset to disable entirely —
# matches the frontend's VITE_SENTRY_DSN behaviour.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
